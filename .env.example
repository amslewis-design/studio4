# Copy to .env.local and fill with your project values. Do NOT commit secrets.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key
# Server-only (store in deployment environment variables)
SUPABASE_SERVICE_ROLE_KEY=service-role-key
RESEND_API_KEY=re_your_resend_api_key
# Must use a sender address on a domain verified in Resend.
RESEND_FROM_EMAIL="Sassy Studio <contacto@sassystudio.com.mx>"
# Address that receives form submissions.
RESEND_TO_EMAIL=contacto@sassystudio.com.mx
